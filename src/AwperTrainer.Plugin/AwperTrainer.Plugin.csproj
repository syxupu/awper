    <ProjectReference Include="../BotControllerApi.Contract/BotControllerApi.Contract.csproj">
      <Private>false</Private>
    </ProjectReference>
    <ProjectReference Include="../RayTraceApi.Contract/RayTraceApi.Contract.csproj">
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>
</Project>
